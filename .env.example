# Copia este archivo a .env. Las claves se guardan solo en el servidor.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Ajusta el modelo a uno disponible en tu cuenta. No se hacen llamadas al arrancar.
AGNTIA_DATA_DIR=./data
AGNTIA_INBOX_DIR=./inbox
# Opcional en localhost; obligatorio antes de dar acceso remoto al servidor.
AGNTIA_ACCESS_TOKEN=
# Límite por archivo, en GB. Configura también el proxy inverso.
AGNTIA_MAX_UPLOAD_GB=10
